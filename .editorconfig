# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Shell scripts
[*.sh]
indent_size = 2
max_line_length = 80

# Markdown files
[*.md]
indent_size = 2
max_line_length = 80

# Dockerfile
[Dockerfile]
indent_style = tab
indent_size = 4
max_line_length = 80
